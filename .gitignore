# LaTeX build artifacts (intermediate) — everything is regenerated by build_guide.sh
build/*
!build/troop413_leadership_guide.pdf

# In case a role or checklist .tex is ever compiled standalone from its own directory
roles/**/*.aux
roles/**/*.log
roles/**/*.pdf
roles/**/*.out
roles/**/*.toc
roles/**/*.fls
roles/**/*.fdb_latexmk
checklists/**/*.aux
checklists/**/*.log
checklists/**/*.pdf
checklists/**/*.out
checklists/**/*.toc
checklists/**/*.fls
checklists/**/*.fdb_latexmk

# ...except checklist PDFs built by build_guide.sh, which are the only
# finished view of those documents (unlike role PDFs, which also appear
# inside the combined guide) and are tracked so they're viewable without a
# LaTeX install, same as build/troop413_leadership_guide.pdf above.
!checklists/onboarding_checklist.pdf

# Editor/OS cruft
.DS_Store
*~
*.swp
